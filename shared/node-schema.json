{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sympact Node Manifest",
  "description": "Shared contract between backend and frontend for node definitions",
  "definitions": {
    "Port": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Port identifier" },
        "type": {
          "type": "string",
          "enum": ["document", "document[]", "text", "embedding", "chunks", "table", "image", "corpus", "json", "any"],
          "description": "Data type this port accepts/produces"
        },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": true }
      },
      "required": ["name", "type"]
    },
    "ConfigField": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Configuration key" },
        "label": { "type": "string", "description": "Display label" },
        "type": {
          "type": "string",
          "enum": ["text", "number", "select", "boolean", "file", "json", "password", "secret", "slider", "tags"],
          "description": "UI component type to render"
        },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Choices for select type"
        },
        "description": { "type": "string" },
        "placeholder": { "type": "string" },
        "depends_on": {
          "type": "object",
          "description": "Conditional visibility: { field: value }",
          "additionalProperties": {}
        }
      },
      "required": ["key", "label", "type"]
    },
    "NodeDefinition": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "Unique node type identifier" },
        "name": { "type": "string", "description": "Human-readable name" },
        "category": { "type": "string", "description": "Grouping category for the sidebar" },
        "icon": { "type": "string", "description": "Icon identifier (emoji or icon name)" },
        "color": { "type": "string", "description": "Hex color for node rendering" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/Port" },
          "description": "Input ports (left side of node)"
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/Port" },
          "description": "Output ports (right side of node)"
        },
        "config_fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/ConfigField" },
          "description": "Configuration form fields"
        }
      },
      "required": ["type", "name", "category", "inputs", "outputs", "config_fields"]
    },
    "WorkflowNode": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique node instance ID" },
        "type": { "type": "string", "description": "References NodeDefinition.type" },
        "config": {
          "type": "object",
          "description": "Key-value config overrides",
          "additionalProperties": {}
        }
      },
      "required": ["id", "type"]
    },
    "Edge": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "source_port": { "type": "string", "default": "output" },
        "target": { "type": "string" },
        "target_port": { "type": "string", "default": "input" },
        "is_dynamic": { "type": "boolean", "default": false }
      },
      "required": ["source", "target"]
    },
    "Workflow": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkflowNode" },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/definitions/Edge" }
        }
      },
      "required": ["nodes"]
    }
  }
}
