{
  "name": "invoice_ar",
  "description": "استخراج بيانات الفاتورة",
  "language": "ar",
  "patterns": [
    {
      "name": "رقم الفاتورة",
      "pattern": "(?:رقم|عدد|N[°o])\\s*:?\\s*(\\d+)",
      "group": 1,
      "mode": "first",
      "category": "invoice",
      "required": true,
      "context_before": "(?:رقم|عدد|فاتورة|Facture|N[°o])",
      "validators": {"min_length": 3}
    },
    {
      "name": "التاريخ",
      "pattern": "\\d{2}[/-]\\d{2}[/-]\\d{4}",
      "mode": "first",
      "category": "dates",
      "required": true,
      "context_before": "(?:تاريخ|Date|في)"
    },
    {
      "name": "المبلغ",
      "pattern": "(\\d[\\d\\s]*[.,]?\\d*)\\s*(?:DT|د\\.ت|دينار|TND)",
      "group": 1,
      "mode": "first",
      "category": "financial",
      "required": true,
      "validators": {"min_length": 1}
    },
    {
      "name": "الضريبة",
      "pattern": "(?:TVA|T\\.V\\.A|ضريبة|أداء)\\s*:?\\s*(\\d[\\d\\s]*[.,]?\\d*)",
      "group": 1,
      "mode": "first",
      "category": "financial",
      "required": false
    },
    {
      "name": "المورد",
      "pattern": "(?:مورد|Fournisseur|شركة|مؤسسة)\\s*:?\\s*([\\u0600-\\u06FF\\w\\s]{3,40})",
      "group": 1,
      "mode": "first",
      "category": "entity",
      "required": false
    }
  ]
}
