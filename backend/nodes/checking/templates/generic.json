{
  "name": "generic",
  "description": "Verification generique de champs communs",
  "fields": [
    {
      "key": "date",
      "label": "Date du document",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "\\d{2}[/-]\\d{2}[/-]\\d{4}"
    },
    {
      "key": "reference",
      "label": "Numero de reference",
      "required": false,
      "severity": "WARNING",
      "pattern": "(?:R[ée]f|REF|N[°o])\\s*:?\\s*(\\w+[-/]?\\d+)"
    },
    {
      "key": "signature",
      "label": "Signature presente",
      "required": true,
      "method": "semantic",
      "severity": "WARNING",
      "description": "Le document contient-il une signature, un cachet ou un tampon officiel ?"
    },
    {
      "key": "amount",
      "label": "Montant",
      "required": false,
      "severity": "INFO",
      "pattern": "(\\d[\\d\\s]*[.,]?\\d*)\\s*(?:DT|€|EUR|TND|USD)"
    }
  ]
}
