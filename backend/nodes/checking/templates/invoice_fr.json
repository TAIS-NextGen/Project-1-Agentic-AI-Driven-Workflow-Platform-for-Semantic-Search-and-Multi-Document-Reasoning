{
  "name": "invoice_fr",
  "description": "Verification completude d'une facture (francais)",
  "language": "fr",
  "fields": [
    {
      "key": "numero_facture",
      "label": "Numero de facture",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "[A-Z]{4}-\\d{4}-\\d{4}"
    },
    {
      "key": "date",
      "label": "Date de facturation",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "\\d{2}[/-]\\d{2}[/-]\\d{4}"
    },
    {
      "key": "montant",
      "label": "Montant total",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "Total\\s*(?:TTC|HT)\\s*:?\\s*(\\d[\\d\\s]*[.,]\\d{2})"
    },
    {
      "key": "tva",
      "label": "TVA",
      "required": false,
      "severity": "INFO",
      "pattern": "(?:TVA|T\\.V\\.A)\\s*(?:\\(\\d+%\\))?\\s*:?\\s*(\\d[\\d\\s]*[.,]\\d{2})"
    },
    {
      "key": "fournisseur",
      "label": "Nom du fournisseur",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "(?:SARL|SAS|EURL|SA)\\s+([A-Z\\u00c0-\\u017f]{2,}(?:\\s+[A-Za-z\\u00c0-\\u017f&]+){1,6})"
    },
    {
      "key": "client",
      "label": "Nom du client",
      "required": true,
      "severity": "WARNING",
      "pattern": "Client\\s*:?\\s*([\\u00c0-\\u017fA-Z]{2,}(?:[\\s-][\\u00c0-\\u017fA-Za-z]+){1,5})"
    }
  ]
}
