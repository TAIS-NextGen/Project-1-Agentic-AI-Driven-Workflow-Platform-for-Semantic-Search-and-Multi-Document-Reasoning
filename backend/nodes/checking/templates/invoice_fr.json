{
  "name": "invoice_fr",
  "description": "Verification completude d'une facture (francais)",
  "fields": [
    {
      "key": "numero_facture",
      "label": "Numero de facture",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "(?:N[°o]|Num[ée]ro|Facture)\\s*:?\\s*(\\w+[-/]?\\d+)"
    },
    {
      "key": "date",
      "label": "Date de facturation",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "\\d{2}[/-]\\d{2}[/-]\\d{4}"
    },
    {
      "key": "montant",
      "label": "Montant total",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "(\\d[\\d\\s]*[.,]?\\d*)\\s*(?:DT|€|EUR|TND|TTC)"
    },
    {
      "key": "tva",
      "label": "TVA",
      "required": false,
      "severity": "INFO",
      "pattern": "(?:TVA|T\\.V\\.A)\\s*:?\\s*(\\d[\\d\\s]*[.,]?\\d*)"
    },
    {
      "key": "fournisseur",
      "label": "Nom du fournisseur",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "(?:Fournisseur|Soci[ée]t[ée]|Raison sociale)\\s*:?\\s*([\\w\\s]{3,40})"
    },
    {
      "key": "client",
      "label": "Nom du client",
      "required": true,
      "severity": "WARNING",
      "pattern": "(?:Client|Acheteur|Destinataire)\\s*:?\\s*([\\w\\s]{3,40})"
    }
  ]
}
