{
  "name": "claim_dossier",
  "description": "Verification completude dossier sinistre automobile (assurance)",
  "fields": [
    {
      "key": "police_report_reference",
      "label": "Numero PV de police",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "PV\\s*N?[°o]?\\s*\\d{4,8}"
    },
    {
      "key": "accident_date",
      "label": "Date de l'accident",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "\\d{2}[/-]\\d{2}[/-]\\d{4}"
    },
    {
      "key": "insured_name",
      "label": "Nom de l'assure",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "(?:Assur[ée]|Nom|Name)[\\s:]*([\\w\\s]{3,40})"
    },
    {
      "key": "vehicle_plate",
      "label": "Numero d'immatriculation",
      "required": true,
      "severity": "CRITICAL",
      "pattern": "\\d{1,4}\\s*TUN\\s*\\d{1,4}"
    },
    {
      "key": "medical_certificate_present",
      "label": "Certificat medical present",
      "required": true,
      "method": "semantic",
      "severity": "WARNING",
      "description": "Un certificat medical decrivant les blessures est-il joint au dossier ? Repondre found=true seulement si un certificat medical explicite est mentionne."
    },
    {
      "key": "damage_estimate_amount",
      "label": "Montant estime des degats",
      "required": false,
      "severity": "INFO",
      "pattern": "(\\d[\\d\\s]*[.,]?\\d*)\\s*(?:DT|TND)"
    }
  ]
}
